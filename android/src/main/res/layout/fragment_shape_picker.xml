<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tool_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/shapeArrow"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_shape_arrow" />

    <ImageView
        android:id="@+id/shapeTriangle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_shape_triangle" />

    <ImageView
        android:id="@+id/shapeSquare"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_shape_square" />

    <ImageView
        android:id="@+id/shapeCircle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_shape_circle" />

</LinearLayout>